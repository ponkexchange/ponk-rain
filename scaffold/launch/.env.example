# =============================================================================
# @ponkrain/launch - environment example
#
# Copy this file to `.env.local` and fill in the values for your deployment:
#
#     cp .env.example .env.local
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle. All
# others are server-only (proxy routes, server components, storage drivers).
#
# The app validates these at boot via src/lib/env.ts (zod). A missing required
# var fails fast with a clear message instead of a cryptic runtime error.
# =============================================================================

# -----------------------------------------------------------------------------
# Backend clouds API (reads: /clouds/pools, /clouds/pool/:address, /clouds/swaps,
# /clouds/stats, /clouds/volume, /clouds/fees, /clouds/portfolio, /clouds/feed)
# -----------------------------------------------------------------------------

# Public base URL of OUR backend clouds API. The browser opens the SSE feed
# (EventSource) against this directly, so it must be reachable from the client.
NEXT_PUBLIC_API_URL=https://api.ponk.exchange

# Server-side base URL of the backend clouds API, used by the same-origin
# /api/* proxy routes and server components. May equal NEXT_PUBLIC_API_URL or
# point at an internal address (e.g. http://clouds-api:8080) not exposed to the
# public internet. If unset, the proxies fall back to NEXT_PUBLIC_API_URL.
API_URL=https://api.ponk.exchange

# -----------------------------------------------------------------------------
# Ponk Clouds on-chain (wallet + SDK transaction building)
# -----------------------------------------------------------------------------

# Solana RPC endpoint the wallet/SDK use to build and send pool-create, swap,
# and liquidity transactions. A local validator today; mainnet after audit.
# Default: https://api.mainnet-beta.solana.com
NEXT_PUBLIC_PONK_CLOUDS_RPC=https://api.mainnet-beta.solana.com

# Ponk Clouds program id override. Defaults to the real deployed program
# (DJxQvbEtBFngkmtpEcB41Y4qv4apUFsqUvZvG7AHbT7M) in src/lib/config.ts. Set this
# only when running against a local/devnet redeploy of the program.
# NEXT_PUBLIC_PONK_CLOUDS_PROGRAM=DJxQvbEtBFngkmtpEcB41Y4qv4apUFsqUvZvG7AHbT7M

# -----------------------------------------------------------------------------
# Token-metadata storage (used only by POST /api/token/metadata)
#
# Selects where uploaded token logos/metadata are persisted. The clone-and-run
# default ("local") writes under public/uploads and needs no external account.
# Switch to "s3" (S3 / Cloudflare R2) for production.
# -----------------------------------------------------------------------------

# local | s3   (default: local)
TOKEN_STORAGE_DRIVER=local

# --- S3 / R2 driver (required only when TOKEN_STORAGE_DRIVER=s3) --------------
# STORAGE_S3_BUCKET=ponk-rain-tokens
# STORAGE_S3_REGION=auto
# STORAGE_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# Public base URL prefix for stored objects (CDN / bucket public URL). Used to
# build the returned image/uri when the driver is s3.
# STORAGE_PUBLIC_BASE_URL=https://cdn.ponk.exchange/tokens
